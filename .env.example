# Directory where saved files (.pdf / .md / .tex / .org) are written.
# Defaults to the iCloud ReadLater inbox on macOS, ~/ReadLater/inbox elsewhere.
# The --output-dir CLI flag takes precedence over this.
#OUTPUT_DIR=/var/lib/margin/inbox

# Bind address and port (also settable via --host / --port flags).
#HOST=0.0.0.0
#PORT=8000

# Formats a save writes when the request doesn't specify — comma-separated
# subset of pdf, md, tex, org. Honored by every capture path (bookmarklet,
# iOS shortcut, /save, and the queue's pre-checked boxes). Default: pdf,md,tex.
#DEFAULT_FORMATS=pdf,md,tex

# Optional API token. When set, every endpoint except /health requires it
# (Authorization: Bearer header, ?token= parameter, or the browser cookie set
# after one authenticated visit). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#MARGIN_TOKEN=

# Let saves reach addresses inside this machine or its network (loopback,
# 10.x, 192.168.x, link-local, cloud metadata). Off by default: Margin fetches
# whatever URL it is given and then serves the result back, so an address
# inside your network is a way to read it through Margin. Turn it on if you
# save from an internal wiki.
#MARGIN_ALLOW_PRIVATE_URLS=1

# Cross-origin access, comma-separated origins. Unset means none: a page you
# are visiting cannot read this instance's answers. Name an origin here only
# for a browser extension or fetch client of your own.
#MARGIN_CORS_ORIGINS=https://example.invalid

# Mathpix credentials — only needed for POST /save-pdf (PDF → Markdown OCR).
MATHPIX_APP_ID=your_app_id_here
MATHPIX_APP_KEY=your_app_key_here
